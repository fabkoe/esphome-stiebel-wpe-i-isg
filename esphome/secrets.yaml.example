# Nach secrets.yaml kopieren und ausfuellen.
# secrets.yaml ist per .gitignore vom Repo ausgeschlossen!
wifi_ssid: "MEIN-WLAN"
wifi_password: "MEIN-PASSWORT"
# Passwort fuer OTA-Updates (frei waehlbar, min. 8 Zeichen).
ota_password: "MEIN-OTA-PASSWORT"

# Nur fuer den optionalen RE-Sniffer (wpe-i-sniffer.yaml) noetig.
# MQTT-Broker fuer den CAN-Firehose (z. B. Mosquitto-Add-on in Home Assistant).
mqtt_broker: "192.168.1.10"
mqtt_username: "MQTT-BENUTZER"
mqtt_password: "MQTT-PASSWORT"
